# ==============================================================================
# Automated Lead Generation & Outreach System - Environment Configuration
# ==============================================================================

# System Environment
ENVIRONMENT=production
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=https://lead-intel.pages.dev

# Database Configuration (Neon Managed PostgreSQL)
# Example: postgresql://username:password@ep-cool-butterfly-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=30

# Security & JWT Authentication
SECRET_KEY=change-this-to-a-very-secure-random-32-byte-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google Gemini AI Flash Engine
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_PROMPT_VERSION=v1.0.0

# Contact Enrichment Providers (Subject to approved access & budget)
CONTACTOUT_API_KEY=
SNOVIO_API_USER_ID=
SNOVIO_API_SECRET=
ENRICHMENT_DAILY_CREDIT_BUDGET=50
ENRICHMENT_MONTHLY_CREDIT_BUDGET=500

# Email Verification Provider
EMAIL_VERIFICATION_PROVIDER=mock_and_smtp
EMAIL_VERIFICATION_API_KEY=
EMAIL_VERIFICATION_DAILY_BUDGET=200

# Outreach Email Dispatcher (Strict Human Approval Required)
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=outreach@yourdomain.com
EMAIL_FROM_NAME="Lead Outreach Team"
DAILY_SEND_LIMIT=50
MONTHLY_SEND_LIMIT=1000

# Webhook Security & Callback Processing
WEBHOOK_HMAC_SECRET=your-secure-webhook-hmac-secret-signature

# n8n Automation Orchestrator
N8N_HOST=n8n
N8N_PORT=5678
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=
N8N_WEBHOOK_URL=http://fastapi:8000/api/v1/webhooks/n8n
N8N_ENCRYPTION_KEY=super-secret-n8n-encryption-key-for-credentials

# Playwright Scraper Worker (Approved Sources Only)
PLAYWRIGHT_CONCURRENCY_LIMIT=2
SCRAPER_HEADLESS=true
APPROVED_SOURCES_ONLY=true
