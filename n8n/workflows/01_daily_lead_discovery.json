{
  "name": "01_Daily_Lead_Discovery",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "node-cron-schedule",
      "name": "Daily 6AM Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://fastapi:8000/api/v1/discovery/sources",
        "authentication": "none",
        "options": {}
      },
      "id": "node-fetch-sources",
      "name": "Fetch Approved Sources",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "command": "python /worker/scraper.py"
      },
      "id": "node-run-scraper",
      "name": "Trigger Playwright Worker",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://fastapi:8000/api/v1/health/ping",
        "options": {}
      },
      "id": "node-log-completion",
      "name": "Log Discovery Completion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Daily 6AM Schedule": {
      "main": [
        [
          {
            "node": "Fetch Approved Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Approved Sources": {
      "main": [
        [
          {
            "node": "Trigger Playwright Worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Playwright Worker": {
      "main": [
        [
          {
            "node": "Log Discovery Completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
